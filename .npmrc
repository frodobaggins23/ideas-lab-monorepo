# @lab/* are local workspaces only. The @lab scope is not ours on the public registry, so point it at
# a host that cannot resolve: npm can then never download an @lab package from someone else.
@lab:registry=https://npm-scope-reserved.invalid/

# Install scripts of dependencies run only when listed in `allowScripts` in package.json; any
# unreviewed one fails the install instead of running. Override deliberately with
# `--dangerously-allow-all-scripts` or approve it with `npm install-scripts approve <pkg>`.
strict-allow-scripts=true
