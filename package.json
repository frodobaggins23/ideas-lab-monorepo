{
    "name": "ideas-lab-monorepo",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "apps/*",
        "libs/*",
        "tools"
    ],
    "scripts": {
        "typecheck": "nx run-many -t typecheck",
        "lint": "nx run-many -t lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "nx run-many -t test:run",
        "test:run": "nx run-many -t test:run",
        "build": "nx run-many -t build",
        "prepare": "husky",
        "lab:vercel-project": "NODE_USE_ENV_PROXY=1 node tools/src/createVercelProject.ts",
        "lab:deployment": "NODE_USE_ENV_PROXY=1 node tools/src/waitForDeployment.ts",
        "lab:vercel-status": "NODE_USE_ENV_PROXY=1 node tools/src/vercelStatus.ts",
        "lab:push": "sh .husky/pre-push && NODE_USE_ENV_PROXY=1 node tools/src/pushBranch.ts",
        "lab:new-app": "node tools/src/newApp.ts",
        "lab:check-package": "NODE_USE_ENV_PROXY=1 node tools/src/checkPackage.ts",
        "lab:add": "NODE_USE_ENV_PROXY=1 node tools/src/addPackage.ts"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@nx/eslint": "23.3.0",
        "@nx/js": "23.3.0",
        "@nx/vite": "23.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "nx": "23.3.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "serve": "14.2.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "allowScripts": {
        "nx": false
    }
}
